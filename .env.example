# Google AI API key (platform free tier — primary model provider)
# Get one at https://aistudio.google.com/
GOOGLE_AI_API_KEY=

# Anthropic API key (optional — for dev/fallback)
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# MCP gateway URL (default: local gateway)
MCP_GATEWAY_URL=http://localhost:8000/mcp

# MCP gateway auth token (optional locally, required in production)
# Set the same token on the Railway gateway as MCP_AUTH_TOKEN
MCP_AUTH_TOKEN=

# Vercel Postgres / Neon connection string
DATABASE_URL=

# NextAuth secret — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# NextAuth base URL
NEXTAUTH_URL=http://localhost:3000

# Resend API key for magic-link emails
# Get one at https://resend.com/
RESEND_API_KEY=

# From address for magic-link emails (must be a verified Resend sender)
EMAIL_FROM=

# 32-byte hex secret for BYOK key encryption — generate with: openssl rand -hex 32
ENCRYPTION_SECRET=

# Vercel AI Gateway API key (optional — enables unified routing, per-request costs,
# and native BYOK/platform distinction). Get one at vercel.com/<team>/~/ai-gateway/api-keys
AI_GATEWAY_API_KEY=

# Set to "1" to route platform-key traffic through the Vercel AI Gateway.
# Any other value (unset, "0") keeps the existing direct-SDK path. BYOK is never routed.
USE_AI_GATEWAY=

# Stats NZ (Aotearoa Data Explorer) subscription key — injected by /api/sdmx-proxy
# on every request to api.data.stats.govt.nz. Scope to Production only in Vercel so
# branch preview URLs don't expose an unauthenticated proxy with the key.
SDMX_STATSNZ_KEY=

# Country Snapshots module — set to "0" to exclude the /countrysnapshots area
# (routes return 404, lib not bundled into runtime pages).
INCLUDE_COUNTRY_SNAPSHOTS=1

# Shared access password for the /countrysnapshots area. Required in production.
# Anyone with this password can browse all snapshots and use the read-only AI chat.
COUNTRY_SNAPSHOTS_PASSWORD=

# Daily turn cap per anonymous snapshot cookie (default 10).
SNAPSHOT_CHAT_DAILY_TURNS=10

# Catalogue access mode for the AI in snapshot sessions: "prompt" (default) bakes
# the catalogue into the system prompt; "tool" exposes it via a tool the agent calls.
SNAPSHOT_CATALOGUE_MODE=prompt

# --- Usage caps (open / public tier) ------------------------------------
# All tunable; an admin-panel control is the planned follow-up.
# Per-user agent turns per rolling 24h (default 20).
OPEN_TIER_DAILY_TURNS=20
# Per-user published dashboards, cumulative (default 5).
OPEN_TIER_MAX_DASHBOARDS=5
# Global cumulative AI-spend ceiling in USD; the circuit breaker for everyone
# (default 1000). When reached, new agent turns are refused service-wide.
AI_BUDGET_CAP_USD=1000
# Start of the budget window (ISO date). Defaults to the cost-accuracy cutoff
# (COST_TRUSTED_FROM). Set to a fresh date at beta launch to zero the budget.
AI_BUDGET_EPOCH=

# --- MCP tool policy ----------------------------------------------------
# Which gateway tools the AGENT is offered (the app calls the rest directly).
# Default: the documented discovery workflow (8 of the gateway's 19 tools).
# Comma-separated list to override, or "off" to pass all tools through
# (useful for A/B testing the policy). See lib/mcp-tool-policy.ts.
MCP_TOOL_ALLOWLIST=

# --- OAuth sign-in (docs/oauth-setup.md) --------------------------------
# Each provider is registered only when its ID is present, so the app runs
# unchanged until you create the provider apps. Auth.js reads these by name.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Accept any authenticated provider identity. Off by default: adding a
# provider must not open the service as a side effect. With it on, the usage
# caps are the cost control rather than the invite list.
AUTH_OPEN_SIGNUP=

# Institutional domains whose members may sign in without an invite.
# Comma-separated, no @. "spc.int" matches that domain only; write ".spc.int"
# with a leading dot to admit subdomains too. Exact is the default because
# subdomains are a wider grant than they look.
# Complements the invite list rather than replacing it: many NSO staff in the
# region work from personal addresses. See docs/oauth-setup.md.
AUTH_ALLOWED_EMAIL_DOMAINS=
